    {
      "parameters": {
        "jsCode": "// Get current timestamp\nconst currentTimestamp = new Date().toISOString();\n\n// Access the input data\nconst inputData = $input.all();\nconst users = inputData[0].json.users;\n\n// Process the data\nconst processedUsers = [];\n\n// Filter and map users\nconst filtered = users\n  .filter(user => {\n    // Filter only users with email domain \"x.dummyjson.com\"\n    const emailDomain = user.email.split('@')[1];\n    return emailDomain === 'x.dummyjson.com';\n  })\n  .map(user => ({\n    full_name: `${user.firstName} ${user.lastName}`,\n    email: user.email,\n    phone: user.phone,\n    company_name: user.company.name,\n    blood_group: user.bloodGroup,\n    latitude: user.address.coordinates.lat,\n    longitude: user.address.coordinates.lng,\n    processed_at: currentTimestamp\n  }));\n\n// Add each processed user as a separate output item\nfiltered.forEach(user => {\n  processedUsers.push({ json: user });\n});\n\nreturn processedUsers;"
      },
